{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StudioX AI",
  "version": "0.1.3",
  "identifier": "ai.studiox.editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "StudioX AI",
        "width": 1600,
        "height": 960,
        "minWidth": 1180,
        "minHeight": 700,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' http://127.0.0.1:* asset: http://asset.localhost blob: data:; media-src 'self' http://127.0.0.1:* asset: http://asset.localhost blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ws://localhost:1420 ipc: http://ipc.localhost asset: http://asset.localhost http://127.0.0.1:11434 http://localhost:11434",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "**"
          ],
          "requireLiteralLeadingDot": false
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "StudioX",
    "category": "Video",
    "shortDescription": "AI-powered professional video editor",
    "copyright": "\u00a9 StudioX",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "binaries/*"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "English",
          "Arabic"
        ],
        "displayLanguageSelector": true,
        "installMode": "currentUser"
      },
      "wix": {
        "language": [
          "en-US"
        ]
      }
    }
  }
}
